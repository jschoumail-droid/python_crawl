#sorted(iterable,key=None,reverse=False)
#  iterable: 任何可迭代的物件。
#  key:帶有一個參數的函數，用於從可迭代物件中提取比較鍵。
#  reverse: 布林值，True 表示降序排序，False（預設值）表示升序排序。
#  回傳值: 一個新的排序後的列表

names=['Ming','Jennifer','Andrew','Boris']
lst1=sorted(names,key=lambda x :len(x))
#lst1=sorted(names,lambda x :len(x)) #error，少了key=
#lst1=sorted(names) #correct

print(lst1)